{
  "schema": "video-editing-agent-document-registry/v1",
  "updated": "2026-08-21",
  "purpose": "Compact attention-aware map for repository documentation and control surfaces. The exhaustive tracked-file manifest is generated by tools/maintenance/document_registry.py.",
  "attention_classes": {
    "CORE": "Normal current-work entry points; read first when relevant.",
    "ON_DEMAND": "Active material; open only when the current task touches its area.",
    "EVIDENCE_ONLY": "Validation/log/research history; consult for proof or rationale.",
    "EXCLUDED_DEFAULT": "Known location but excluded from ordinary agent reading."
  },
  "default_excluded": [
    "docs/archive/**",
    ".private/**",
    ".tools/**",
    ".uv-cache*/**",
    ".venv/**",
    "build/**",
    "dist/**"
  ],
  "canonical_entries": [
    {
      "path": "AGENTS.md",
      "role": "repository agent attention/safety entry",
      "attention": "CORE",
      "lifecycle": "ACTIVE"
    },
    {
      "path": "docs/README.md",
      "role": "documentation authority/navigation map",
      "attention": "CORE",
      "lifecycle": "ACTIVE"
    },
    {
      "path": "docs/product/PRODUCT_CONSTITUTION_V1.0.md",
      "role": "highest product authority",
      "attention": "CORE",
      "lifecycle": "ACTIVE"
    },
    {
      "path": "docs/architecture/ARCHITECTURE_CONTRACT_V0.2.md",
      "role": "active architecture baseline",
      "attention": "CORE",
      "lifecycle": "ACTIVE"
    },
    {
      "path": "docs/operations/CURRENT_CONTROL_STATE.md",
      "role": "machine-readable live control state",
      "attention": "CORE",
      "lifecycle": "LIVE"
    },
    {
      "path": "docs/roadmap/CURRENT_PHASE_STATUS.md",
      "role": "human-readable live phase state",
      "attention": "CORE",
      "lifecycle": "LIVE"
    },
    {
      "path": "docs/operations/CURRENT_WORK_ORDER.md",
      "role": "currently authorized construction boundary",
      "attention": "CORE",
      "lifecycle": "LIVE"
    },
    {
      "path": "docs/roadmap/STAGE_A_COMPLETION_GATE.md",
      "role": "Stage-A structural 100 percent completion contract",
      "attention": "CORE",
      "lifecycle": "ACTIVE"
    },
    {
      "path": "docs/operations/DOCUMENT_CONTROL_POLICY.md",
      "role": "document lifecycle/date/archive/registry rules",
      "attention": "ON_DEMAND",
      "lifecycle": "ACTIVE"
    },
    {
      "path": "docs/operations/WINDOWS_DESKTOP_PACKAGING_READINESS.md",
      "role": "Windows packaging readiness and release boundary",
      "attention": "ON_DEMAND",
      "lifecycle": "ACTIVE"
    },
    {
      "path": "docs/operations/WINDOWS_RUNTIME_DEPENDENCY_INVENTORY.md",
      "role": "Windows runtime/dependency closure inventory",
      "attention": "ON_DEMAND",
      "lifecycle": "ACTIVE"
    }
  ],
  "directory_map": [
    {"path": "docs/product/**", "role": "product authority/guidance", "attention": "ON_DEMAND"},
    {"path": "docs/architecture/**", "role": "active architecture", "attention": "ON_DEMAND"},
    {"path": "docs/capabilities/**", "role": "capability specifications", "attention": "ON_DEMAND"},
    {"path": "docs/adr/**", "role": "current architecture decisions", "attention": "ON_DEMAND"},
    {"path": "docs/roadmap/**", "role": "roadmap/live phase/completion gates", "attention": "ON_DEMAND"},
    {"path": "docs/operations/**", "role": "execution/control/release readiness", "attention": "ON_DEMAND"},
    {"path": "docs/validation/**", "role": "durable acceptance evidence", "attention": "EVIDENCE_ONLY"},
    {"path": "docs/logs/**", "role": "incidents/probes/chronicle/lessons", "attention": "EVIDENCE_ONLY"},
    {"path": "docs/research/**", "role": "non-normative research evidence", "attention": "EVIDENCE_ONLY"},
    {"path": "docs/upstream/**", "role": "active upstream/reuse/license ledger", "attention": "ON_DEMAND"},
    {"path": "docs/archive/**", "role": "retired provenance only", "attention": "EXCLUDED_DEFAULT"},
    {"path": ".github/**", "role": "automation/workflow navigation", "attention": "ON_DEMAND"},
    {"path": "scripts/**", "role": "operator scripts and local workflow navigation", "attention": "ON_DEMAND"},
    {"path": "src/README.md", "role": "source package map", "attention": "ON_DEMAND"},
    {"path": "tests/README.md", "role": "test surface map", "attention": "ON_DEMAND"},
    {"path": "tools/**/README.md", "role": "tool/probe/maintenance maps", "attention": "ON_DEMAND"}
  ],
  "automation": {
    "generator": "tools/maintenance/document_registry.py",
    "workflow": ".github/workflows/document-registry.yml",
    "exhaustive_manifest": "GitHub Actions artifact: document-registry-full",
    "archive_moves_are_automatic": false
  }
}
