{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-editing-agent.local/schemas/runtime-manifest-v1.json",
  "title": "Video Editing Agent Runtime Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "application_version", "components"],
  "properties": {
    "schema": {"const": "video-editing-agent/runtime-manifest/v1"},
    "application_version": {"type": "string", "minLength": 1},
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "kind", "classification", "capability", "version", "location_policy",
          "provenance", "license_state", "inclusion", "hash_policy", "platform",
          "architecture", "absence_fatal"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
          "kind": {"enum": ["executable", "model", "resource", "runtime", "remote-service", "development-tool"]},
          "classification": {"enum": ["bundled-required", "bundled-optional", "managed-optional", "remote", "development-only"]},
          "capability": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "location_policy": {"type": "string", "minLength": 1},
          "provenance": {"type": "string", "minLength": 1},
          "license_state": {"enum": ["reviewed", "external-review-required", "not-applicable"]},
          "inclusion": {"enum": ["include", "external", "exclude"]},
          "hash_policy": {"enum": ["exact", "build-generated", "not-applicable"]},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "notice_path": {"type": "string", "minLength": 1},
          "platform": {"type": "string", "minLength": 1},
          "architecture": {"type": "string", "minLength": 1},
          "absence_fatal": {"type": "boolean"}
        }
      }
    }
  }
}
